---
const devices = [
  { slug: 'cmf-watch-pro-2', label: 'CMF Watch Pro 2', state: 'supported' },
  { slug: 'cmf-watch-pro-3', label: 'CMF Watch Pro 3', state: 'planned' },
];

const path = Astro.url.pathname;
const current = devices.find((device) => path.includes(`/devices/${device.slug}/`)) ?? devices[0];
const base = import.meta.env.BASE_URL;
---

<div class="device-switcher">
  <details class="device-menu" id="device-menu">
    <summary class="device-button">
      <span class="device-label">{current.label}</span>
      <span class="device-caret" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </summary>
    <div class="device-panel">
      <p class="device-panel-title">Device</p>
      <ul class="device-list">
        {
          devices.map((device) =>
            device.state === 'supported' ? (
              <li>
                <a
                  href={`${base}devices/${device.slug}/`}
                  class:list={['device-link', device.slug === current.slug && 'is-current']}
                  aria-current={device.slug === current.slug ? 'page' : undefined}
                >
                  <span>{device.label}</span>
                  {device.slug === current.slug && (
                    <span class="device-check" aria-hidden="true">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <path d="m5 13 4 4 10-10" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </span>
                  )}
                </a>
              </li>
            ) : (
              <li>
                <span class="device-link is-planned" aria-disabled="true">
                  <span>{device.label}</span>
                  <span class="device-badge">planned</span>
                </span>
              </li>
            )
          )
        }
      </ul>
    </div>
  </details>
</div>

<script>
  const menu = document.getElementById('device-menu');
  if (menu) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.open = false;
    });
  }
</script>

<style>
  .device-switcher {
    position: relative;
    display: flex;
    align-items: center;
  }

  .device-menu {
    position: relative;
  }

  .device-button {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.3rem;
    cursor: pointer;
    list-style: none;
    font-size: var(--sl-text-sm);
    line-height: 1.4;
    white-space: nowrap;
    color: var(--sl-color-text);
  }

  .device-button::-webkit-details-marker {
    display: none;
  }

  .device-button:hover {
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
  }

  .device-label {
    font-weight: 600;
  }

  .device-caret {
    display: inline-flex;
    align-items: center;
    color: var(--sl-color-gray-3);
  }

  .device-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 20;
    min-width: 14rem;
    padding: 0.5rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    box-shadow: var(--sl-shadow-md);
  }

  .device-panel-title {
    margin: 0 0 0.35rem;
    padding: 0 0.5rem;
    font-size: var(--sl-text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-3);
  }

  .device-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .device-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.35rem 0.5rem;
    border-radius: 0.25rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text);
    text-decoration: none;
  }

  a.device-link:hover {
    background: var(--sl-color-gray-6);
    text-decoration: none;
  }

  .device-link.is-current {
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }

  .device-link.is-planned {
    color: var(--sl-color-gray-4);
    cursor: default;
  }

  .device-check {
    display: inline-flex;
    color: var(--sl-color-text-accent);
  }

  .device-badge {
    font-size: var(--sl-text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3);
  }
</style>
